# ===========================================
# SISStateReportingManager Environment Configuration
# ===========================================
# Copy this file to .env and update with your values
# WARNING: Never commit your .env file to version control!

# ===========================================
# DATABASE CONFIGURATION
# ===========================================

# PostgreSQL connection settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sis_manager
POSTGRES_PORT=5432

# Full database URL (used by backend)
# For Docker: postgresql+asyncpg://postgres:postgres@db:5432/sis_manager
# For local: postgresql+asyncpg://postgres:postgres@localhost:5432/sis_manager
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sis_manager

# ===========================================
# REDIS CONFIGURATION
# ===========================================

REDIS_PORT=6379
# For Docker: redis://redis:6379
# For local: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ===========================================
# BACKEND CONFIGURATION
# ===========================================

# Port for FastAPI backend
BACKEND_PORT=8000

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Authentication settings
# IMPORTANT: Change these values in production!
AUTH_SECRET_KEY=change-this-secret-key-in-production-use-at-least-32-chars
AUTH_PASSWORD=admin123

# JWT token expiration in minutes (default: 24 hours)
TOKEN_EXPIRE_MINUTES=1440

# ===========================================
# FRONTEND CONFIGURATION
# ===========================================

# Port for Next.js frontend
FRONTEND_PORT=3000

# API URL for frontend to connect to backend
# For Docker: http://backend:8000
# For local: http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ===========================================
# AI SERVICES
# ===========================================

# Anthropic API key for Claude-powered analysis
# Required for AI-powered scoring and analysis features
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ===========================================
# APPLICATION SETTINGS
# ===========================================

# Application name
APP_NAME=SISStateReportingManager

# Debug mode (set to false in production)
DEBUG=false

# ===========================================
# LOGGING & MONITORING
# ===========================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Enable detailed SQL logging (development only)
SQL_ECHO=false
